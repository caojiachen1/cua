.*
# The shared git hooks are part of the repo: enable once with
#   git config core.hooksPath .githooks
!.githooks/
# Build output
/target/
target-final/
/bin/
obj/
tools/*/bin/
tools/*/obj/

# Prebuilt install archive IS committed (install.ps1 consumes it): dist/*.zip
# stays tracked on purpose. Only stray unpack/staging dirs are ignored.
/dist/*.tmp
/dist/*-stage/

# Local runtime and debug artifacts
*.log
*.mp4
.tmp-*
.e2e/
.e2e-*/
.e2e-perception/
.tmp-burn-yolo/
.models/
.venv-oracle/
/*.json
/*.err
/*.png

# Locally generated reports, screenshots and samples (matched by kind, not by name)
/*SUMMARY*.md
docs/
docs/*.png
docs/*-samples/
docs/*-report.md
docs/*-comparison.md
tools/*-report*.md

# Developer notes stay local: they document internal traps for whoever is
# editing the code, and must never appear in the public repo or in user docs.
docs/*-dev.md

# Progress/status notes stay local and are never committed
PROGRESS*.md
STATUS*.md
*进度*.md

# Browser extension runtime state (the unpacked copy lives in the data dir)
browser/*.log
browser/*.pid
browser/*.pem
