# Build output
/target/
target-final/
/bin/
obj/
tools/*/bin/
tools/*/obj/

# Local runtime and debug artifacts
*.log
*.mp4
.tmp-*
.e2e/
.e2e-*/
.e2e-perception/
.tmp-burn-yolo/
.models/
.venv-oracle/
/*.json
/*.err
/*.png

# Locally generated reports, screenshots and samples (matched by kind, not by name)
/*SUMMARY*.md
docs/*.png
docs/*-samples/
docs/*-report.md
docs/*-comparison.md
tools/*-report*.md

# Progress/status notes stay local and are never committed
PROGRESS*.md
STATUS*.md
*进度*.md
